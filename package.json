{
  "name": "brikuma-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "preview": "node scripts/preview.mjs",
    "start": "node scripts/preview.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "typecheck:core": "tsc --project tsconfig.core.json",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:core": "vitest run tests/unit",
    "test:components": "vitest run tests/component",
    "test:e2e": "playwright test journeys.spec.ts responsive.spec.ts bundle-network.spec.ts editor-specialist.spec.ts editor-ux.spec.ts product-continuity.spec.ts building-journey.spec.ts",
    "test:a11y": "playwright test a11y.spec.ts",
    "architecture:check": "depcruise src --config .dependency-cruiser.cjs --output-type err-long",
    "architecture:test": "node --test tests/architecture/*.test.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "hooks:install": "husky",
    "hooks:check": "node --test scripts/quality.test.mjs",
    "review:check": "node scripts/quality.mjs review",
    "check:commit": "node scripts/quality.mjs commit",
    "check:push": "node scripts/quality.mjs push",
    "deps:audit": "npm audit --omit=dev && npm audit",
    "perf:check": "node scripts/performance.mjs",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run typecheck:core && npm run architecture:check && npm run architecture:test && npm test && npm run hooks:check && npm run docs:check && npm run licenses:check && npm run privacy:test",
    "perf:lighthouse": "node scripts/lighthouse.mjs",
    "licenses:generate": "node scripts/licenses.mjs",
    "licenses:check": "node scripts/licenses.mjs --check",
    "test:editor": "playwright test --config=playwright.editor.config.ts",
    "privacy:install": "python3 -B scripts/privacy-install.py",
    "privacy:check": "python3 -B scripts/privacy.py full",
    "privacy:test": "python3 -B scripts/privacy_test.py && python3 -B scripts/github_policy_test.py"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.8.1",
    "lucide-react": "1.48.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "dependency-cruiser": "18.4.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "husky": "9.1.7",
    "jsdom": "30.1.1",
    "lighthouse": "13.6.0",
    "lint-staged": "17.5.1",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "22.23.2",
    "npm": "10.9.8"
  },
  "license": "MIT"
}
